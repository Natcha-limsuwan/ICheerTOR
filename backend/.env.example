NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MongoDB Atlas or a replica set is required; standalone MongoDB is unsupported.
# Host-side local Compose: mongodb://localhost:27017/icheertor?directConnection=true&replicaSet=rs0
# Inside Compose: mongodb://mongo:27017/icheertor?replicaSet=rs0
MONGODB_URI=
# Generate once: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_HOURS=8
TRUST_PROXY=0
RATE_LIMIT_API_MAX=300
ADMIN_EMAILS=
CRON_SECRET=
